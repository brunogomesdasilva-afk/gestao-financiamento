NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Secreta: usada só no servidor para o administrador criar usuários. Nunca coloque NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Envio de relatórios por e-mail (SMTP). Ex. Gmail: smtp.gmail.com, porta 587, usuário = seu e-mail,
# senha = "senha de app" gerada na conta Google. Também são segredos: não os compartilhe.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=Gestão de Financiamento <seu-email@gmail.com>
